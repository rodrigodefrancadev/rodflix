{
  "name": "rodflix-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build:api": "npm run build -w api",
    "build:web": "npm run build -w web",
    "start:api": "npm run start -w api",
    "deploy:api": "npm run build -w api && npm run db:migrate:prod -w api",
    "preview:web": "npm run preview -w web",
    "promote-to-admin": "npm run promote-to-admin -w api --"
  },
  "engines": {
    "node": "24.x"
  }
}