{
  "name": "rodflix-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build:api": "npm run build -w backend",
    "start:api": "npm run start -w backend",
    "deploy:api": "npm run build -w backend && npm run db:migrate:prod -w backend",
    "promote-to-admin": "npm run promote-to-admin -w backend --"
  }
}
